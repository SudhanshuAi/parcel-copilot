# Copy this file to .env, then set real values. Never commit .env.
SESSION_SECRET=replace-with-a-long-random-secret
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_replace_with_your_new_key
GROQ_MODEL=openai/gpt-oss-20b

# Optional OpenAI alternative:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk_replace_with_your_key
# OPENAI_MODEL=gpt-4.1-mini
